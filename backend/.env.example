PORT=5000
MONGODB_URI=
# For mongodb+srv: omit or use 8.8.8.8,1.1.1.1 if querySrv fails; use system for OS DNS only
MONGODB_DNS_SERVERS=
# Set this to your local Vite URL and your Vercel URL in production, for example:
# http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGIN=https://saree-platform.vercel.app,http://localhost:5173
API_SERVICE_NAME=
HOST=
ORDER_NUMBER_PREFIX=
SHIPPING_FLAT_RUPEES=0
# Min ~16+ random chars; used to sign API session tokens (not the same as Firebase web API key).
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Entire service account JSON as ONE LINE (minified, no newlines). Example generator:
#   cd backend && npm run print-firebase-env -- "..\\your-adminsdk.json"
# Or base64 the file into FIREBASE_SERVICE_ACCOUNT_B64. PATH is optional if JSON is inline.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_B64=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_MB=5
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=240
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=120
REQUEST_JSON_LIMIT_KB=256
REQUEST_URL_MAX_LENGTH=2048
AUTH_OTP_SEND_WINDOW_MS=600000
AUTH_OTP_SEND_MAX=4
AUTH_OTP_VERIFY_WINDOW_MS=120000
AUTH_OTP_VERIFY_MAX=5
AUTH_OTP_SUSPEND_MS=120000
CORS_ALLOW_PRIVATE_NETWORK=false
